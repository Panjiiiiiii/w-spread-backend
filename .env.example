# App Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Prisma)
# Replace with your actual PostgreSQL connection string:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wspread_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wspread_db"
# CORS Configuration
CORS_ORIGIN=*

# Supabase Storage (use the server-side service role key only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars
SESSION_TTL_DAYS=30

# RevenueCat webhook authorization (server-side only)
REVENUECAT_WEBHOOK_SECRET=
